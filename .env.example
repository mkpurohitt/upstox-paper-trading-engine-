# =============================================================================
# AlgoDesk environment configuration
# Copy to `.env` and fill in what you have. EVERYTHING IS OPTIONAL in mock mode:
# missing broker / data / LLM keys fall back to realistic mock providers.
# Never commit `.env`. In production inject these from a secrets manager (AWS
# Secrets Manager / KMS in ap-south-1).
# =============================================================================

# ---- application ---------------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
DATA_MODE=mock                     # mock = synthetic data everywhere, live = real providers where configured
EMBEDDED_WORKERS=true              # true: API hosts tick streamer/runners/jobs (single process). Compose sets false.
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATA_REGION=ap-south-1             # DPDP: keep personal data in India
LOG_LEVEL=INFO
LOG_JSON=false                     # true in production (structured logs)

# ---- storage ---------------------------------------------------------------------
# Local default: a SQLite file at <repo>/var/algo.db (no Docker needed; relative paths resolve against the repo root).
# docker compose overrides this with Postgres 16 + TimescaleDB + pgvector. Production must use PostgreSQL, e.g.
# DATABASE_URL=postgresql+asyncpg://algo:algo@localhost:5432/algo
DATABASE_URL=sqlite+aiosqlite:///./var/algo.db
PGVECTOR_ENABLED=false             # true when the vector extension is installed (compose sets true)
REDIS_URL=                         # e.g. redis://localhost:6379/0 ; empty = in-process bus/cache

# ---- auth --------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-64-char-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false                # must be true in production (HTTPS)
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
DEMO_USER_EMAIL=demo@algodesk.in
DEMO_USER_PASSWORD=demo12345

# ---- encryption vault (AES-256-GCM for broker credentials & TOTP seeds) -------------
# 32 random bytes, base64:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_MASTER_KEY=
VAULT_KEY_ID=v1
VAULT_PREVIOUS_KEYS=               # kid:base64key,... kept during key rotation

# ---- market data -----------------------------------------------------------------
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/brokers/upstox/callback
UPSTOX_ANALYTICS_TOKEN=            # Upstox "analytics token" (read-only market data, long-lived)
UPSTOX_RATE_LIMIT_PER_SEC=25
NSE_MCP_URL=                       # e.g. http://localhost:8765/mcp  (NSE MCP server)
NSE_MCP_TRANSPORT=streamable_http  # streamable_http | sse
NSE_MCP_API_KEY=
TICK_INTERVAL_MS=1000              # mock tick cadence
MOCK_SEED=42

# ---- brokers & risk ----------------------------------------------------------------
DEFAULT_BROKER=paper
ORDER_RATE_LIMIT_PER_SEC=8         # per exchange per client; SEBI retail threshold is 10/s
PAPER_SLIPPAGE_BPS=5
PAPER_STARTING_CAPITAL=1000000
PAPER_MARKET_HOURS=true           # orders placed while the exchange is closed queue as AMO and fill at the next open
GLOBAL_KILL_SWITCH=false
ALGO_ID_PREFIX=ALGO-PENDING        # replaced by exchange-assigned Algo-ID after empanelment
EGRESS_STATIC_IP=                  # static egress IP registered with brokers (documentation/UI only)

# ---- AI ------------------------------------------------------------------------------
LLM_PRIMARY_PROVIDER=openai_compat # openai_compat | anthropic | ollama | mock
LLM_PRIMARY_MODEL=gpt-6-luna       # "GPT-6 Luna" via any OpenAI-compatible endpoint
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_CHEAP_MODEL=                   # router: simple Q&A (defaults to primary)
LLM_STRONG_MODEL=                  # router: research/strategy/portfolio (defaults to primary)
ANTHROPIC_API_KEY=                 # used as secondary provider when set
ANTHROPIC_MODEL_STRONG=claude-opus-5-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_PROVIDER=hashing         # hashing (offline) | openai_compat | ollama
EMBEDDING_MODEL=text-embedding-3-small
ADVICE_ENABLED=false               # only with SEBI IA/RA registration
LLM_MAX_TOOL_STEPS=6
LLM_FALLBACKS=anthropic,ollama     # tried in order when the primary errors / times out
OLLAMA_ENABLED=false               # true when the `ollama` compose profile is running
LLM_MOCK_FALLBACK=true             # offline rule-based assistant as the last resort (and when no LLM is configured)
LLM_PRICING_JSON={}                # cost tracking, e.g. {"gpt-6-luna":[2.5,10]} = USD per 1M input/output tokens
RAG_TOP_K=4                        # knowledge-base chunks passed to the model per question

# ---- news ------------------------------------------------------------------------------
NEWS_RSS_FEEDS=https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms,https://www.livemint.com/rss/markets
NEWS_REFRESH_MINUTES=15

# ---- notifications ------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@algodesk.in
TELEGRAM_BOT_TOKEN=
WHATSAPP_WEBHOOK_URL=

# ---- billing (Razorpay TEST mode keys: rzp_test_...) ----------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- observability -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=       # e.g. http://jaeger:4318 (compose --profile observability)
OTEL_SERVICE_NAME=algo-api

# ---- request limits -----------------------------------------------------------------------------
API_RATE_LIMIT_PER_MIN=600
AUTH_RATE_LIMIT_PER_MIN=30

# ---- frontend (build time) ---------------------------------------------------------------------------
API_INTERNAL_URL=http://127.0.0.1:8000   # Next.js rewrites /api/* here (127.0.0.1 avoids IPv6 localhost issues on Windows)
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws
