# Copy to .env and paste live app credentials and sandbox app credentials.
# Live OAuth access tokens are saved automatically at .local/upstox_tokens.json.
APP_NAME=upstox-paper-trading-platform
APP_ENV=local
MODE=paper
LOG_LEVEL=INFO

# Backend / frontend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_WS_BASE_URL=ws://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Persistence
DATABASE_URL=postgresql+psycopg://paper:paper@localhost:5432/paper_trading
REDIS_URL=redis://localhost:6379/0

# Upstox live API app credentials from https://account.upstox.com/developer/apps
UPSTOX_LIVE_API_KEY=PASTE_YOUR_LIVE_API_KEY_HERE
UPSTOX_LIVE_API_SECRET=PASTE_YOUR_LIVE_API_SECRET_HERE
UPSTOX_REDIRECT_URI=http://localhost:8000/broker/callback

# Leave these blank for normal use. OAuth login saves the live access token automatically.
UPSTOX_ACCESS_TOKEN=
UPSTOX_EXTENDED_TOKEN=

# SANDBOX PLACEHOLDERS - PASTE YOUR SANDBOX APP DETAILS HERE
# Upstox sandbox currently does not use OAuth login flow.
# Generate the sandbox access token in Developer Apps and paste it below.
UPSTOX_SANDBOX_API_KEY=PASTE_YOUR_SANDBOX_API_KEY_HERE
UPSTOX_SANDBOX_API_SECRET=PASTE_YOUR_SANDBOX_API_SECRET_HERE
UPSTOX_SANDBOX_REDIRECT_URI=http://localhost:8000/broker/sandbox/callback

# Required for sandbox order API calls. Generated in Upstox Developer Apps.
UPSTOX_SANDBOX_ACCESS_TOKEN=PASTE_YOUR_GENERATED_SANDBOX_ACCESS_TOKEN_HERE
UPSTOX_BASE_URL=https://api.upstox.com
UPSTOX_HFT_BASE_URL=https://api-hft.upstox.com

# Paper trading defaults
BASE_CAPITAL=1000000
DEFAULT_CURRENCY=INR
DEFAULT_INSTRUMENTS=NSE_INDEX|Nifty 50
DOWNLOAD_INSTRUMENTS_ON_START=true
INSTRUMENTS_DIR=data/instruments
ENABLE_LIVE_QUOTE_POLLING=true
ENABLE_LIVE_UPSTOX_WS=false
ENABLE_ORDER_SUBMISSION=false

# RMS defaults
RISK_MAX_LOSS_PER_DAY=20000
RISK_MAX_POSITION_SIZE=100000
RISK_MAX_ORDER_VALUE=250000
RISK_MAX_ORDERS_PER_MINUTE=20
RISK_MAX_TRADES_PER_STRATEGY=100
